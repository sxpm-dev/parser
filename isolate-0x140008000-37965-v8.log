t crypto = ReflectConstruct(function() {}\x2C []\x2C Crypto);\n\nfunction getRandomValues(array) {\n  if (this !== crypto) throw new ERR_INVALID_THIS('Crypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'getRandomValues' on 'Crypto'";\n  webidl.requiredArguments(arguments.length\x2C 1\x2C { prefix });\n\n  return ReflectApply(_getRandomValues\x2C this\x2C arguments);\n}\n\nObjectDefineProperties(\n  Crypto.prototype\x2C {\n    [SymbolToStringTag]: {\n      __proto__: null\x2C\n      enumerable: false\x2C\n      configurable: true\x2C\n      writable: false\x2C\n      value: 'Crypto'\x2C\n    }\x2C\n    subtle: kEnumerableProperty\x2C\n    getRandomValues: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: getRandomValues\x2C\n    }\x2C\n    randomUUID: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: randomUUID\x2C\n    }\x2C\n  });\n\nif (getOptionValue('--no-experimental-global-webcrypto')) {\n  // For backward compatibility\x2C keep exposing CryptoKey in the Crypto prototype\n  // when using the flag.\n  ObjectDefineProperty(Crypto.prototype\x2C 'CryptoKey'\x2C {\n    __proto__: null\x2C\n    enumerable: true\x2C\n    configurable: true\x2C\n    writable: true\x2C\n    value: CryptoKey\x2C\n  });\n}\n\nObjectDefineProperties(\n  SubtleCrypto.prototype\x2C {\n    [SymbolToStringTag]: {\n      __proto__: null\x2C\n      enumerable: false\x2C\n      configurable: true\x2C\n      writable: false\x2C\n      value: 'SubtleCrypto'\x2C\n    }\x2C\n    encrypt: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: encrypt\x2C\n    }\x2C\n    decrypt: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: decrypt\x2C\n    }\x2C\n    s