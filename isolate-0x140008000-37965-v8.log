eImportMeta;\n    meta = importMetaInitializer(meta\x2C context\x2C loader);\n    return meta;\n  }\n}\nObjectSetPrototypeOf(Hooks.prototype\x2C null);\n\n/**\n * There may be multiple instances of Hooks/HooksProxy\x2C but there is only 1 Internal worker\x2C so\n * there is only 1 MessageChannel.\n */\nlet MessageChannel;\nclass HooksProxy {\n  /**\n   * Shared memory. Always use Atomics method to read or write to it.\n   * @type {Int32Array}\n   */\n  #lock;\n  /**\n   * The InternalWorker instance\x2C which lets us communicate with the loader thread.\n   */\n  #worker;\n\n  /**\n   * The last notification ID received from the worker. This is used to detect\n   * if the worker has already sent a notification before putting the main\n   * thread to sleep\x2C to avoid a race condition.\n   * @type {number}\n   */\n  #workerNotificationLastId = 0;\n\n  /**\n   * Track how many async responses the main thread should expect.\n   * @type {number}\n   */\n  #numberOfPendingAsyncResponses = 0;\n\n  #isReady = false;\n\n  constructor() {\n    const { InternalWorker } = require('internal/worker');\n    MessageChannel ??= require('internal/worker/io').MessageChannel;\n\n    const lock = new SharedArrayBuffer(SHARED_MEMORY_BYTE_LENGTH);\n    this.#lock = new Int32Array(lock);\n\n    this.#worker = new InternalWorker(loaderWorkerId\x2C {\n      stderr: false\x2C\n      stdin: false\x2C\n      stdout: false\x2C\n      trackUnmanagedFds: false\x2C\n      workerData: {\n        lock\x2C\n      }\x2C\n    });\n    this.#worker.unref(); // ! Allows the process to eventually exit.\n    this.#worker.on('exit'\x2C process.exit);\n  }\n\n  waitForWorker() {\n    if (!this.#isReady) {\n      const { kIsOnline } = require('internal/worker');\n      if (!this.#worker[kIsOnline]) {\n        debug('wait for signal from worker');\n        AtomicsWait(this.#lock\x2C WORKER_TO_MAIN_THREAD_NOTIFICATION\x2C 0);\n        const response = this.#worker.receiveMessageSync();\n        if (response == 