{
  "name": "example-parser-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "test": "npm run generate && tsx --test scripts/all-tests.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate && npm run typecheck && npm run browser:build --workspaces --if-present",
    "bench": "npm run bench --workspaces --if-present",
    "baseline": "npm run baseline --workspaces --if-present",
    "gate": "npm run gate --workspaces --if-present",
    "audit:parser-contract": "tsx scripts/parser-contract-audit.ts",
    "bench:css:parse": "npm run bench:parse -w @parser3/css",
    "bench:css:json": "npm run bench:json -w @parser3/css",
    "bench:css:round-trip": "npm run bench:round-trip -w @parser3/css",
    "bench:less:parse": "npm run bench:parse -w @parser3/less",
    "bench:less:json": "npm run bench:json -w @parser3/less",
    "bench:less:round-trip": "npm run bench:round-trip -w @parser3/less",
    "bench:scss:parse": "npm run bench:parse -w @parser3/scss",
    "bench:scss:json": "npm run bench:json -w @parser3/scss",
    "bench:scss:round-trip": "npm run bench:round-trip -w @parser3/scss",
    "bench:css:stringify": "npm run bench:stringify -w @parser3/css",
    "bench:scss:stringify": "npm run bench:stringify -w @parser3/scss",
    "bench:check": "tsx scripts/check-parser-benches.ts",
    "pages:build": "tsx scripts/build-pages.ts"
  },
  "devDependencies": {
    "@aws-sdk/util-arn-parser": "^3.804.0",
    "@iarna/toml": "^2.2.5",
    "@js-temporal/polyfill": "^0.4.4",
    "@types/node": "^20.12.12",
    "color-string": "^1.9.1",
    "content-type": "^1.0.5",
    "conventional-commits-parser": "^5.0.0",
    "cookie": "^0.7.2",
    "cron-parser": "^4.9.0",
    "css-tree": "^3.1.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "email-addresses": "^5.0.0",
    "esbuild": "~0.28.0",
    "graphql": "^16.15.0",
    "highlight.js": "^11.12.0",
    "htmlparser2": "^9.1.0",
    "http-parser-js": "^0.5.10",
    "ini": "^4.1.3",
    "ipaddr.js": "^2.5.0",
    "jsep": "^1.6.0",
    "markdown-it": "^14.3.3",
    "ms": "^2.1.3",
    "node-sql-parser": "^5.4.0",
    "parse-cache-control": "^1.0.1",
    "path-to-regexp": "^6.3.0",
    "picomatch": "^4.0.7",
    "postcss": "^8.4.49",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "protobufjs": "^7.6.6",
    "rrule": "^2.8.1",
    "semver": "^7.8.6",
    "spdx-expression-parse": "^3.0.1",
    "tinybench": "^2.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "ulid": "^2.4.0",
    "yaml": "^2.9.1"
  }
}
