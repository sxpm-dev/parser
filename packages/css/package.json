{
  "name": "@parser2/css",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "npm run build -w @parser2/compiler && tsx ../../packages/compiler/src/cli.ts src/schema.ts",
    "build": "tsc -b",
    "test": "tsx --test test/*.test.ts",
    "test:unit": "tsx --test test/css.test.ts",
    "bench:ast": "tsx bench/ast.ts",
    "bench:tokenize": "tsx bench/tokenize.ts",
    "browser:build": "tsx ../../scripts/browser-build.ts css",
    "perf:baseline": "tsx ../../scripts/perf-gate.ts css --write",
    "perf:gate": "tsx ../../scripts/perf-gate.ts css",
    "size:baseline": "npm run browser:build && tsx ../../scripts/size-gate.ts css --write",
    "size:gate": "npm run browser:build && tsx ../../scripts/size-gate.ts css",
    "baseline": "npm run generate && npm run perf:baseline && npm run size:baseline",
    "gate": "npm run generate && npm run perf:gate && npm run size:gate"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@parser2/parser": "0.0.0"
  }
}
