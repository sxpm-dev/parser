{
  "name": "@parser2/iso-duration",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "npm run build -w @parser2/compiler && npm run generate:ts",
    "generate:ts": "tsx ../../packages/compiler/src/cli.ts src/schema.ts --backend ts",
    "generate:rs": "tsx ../../packages/compiler/src/cli.ts src/schema.ts --rs",
    "generate:bcode": "tsx ../../packages/compiler/src/cli.ts src/schema.ts --bcode",
    "generate:all": "npm run build -w @parser2/compiler && tsx ../../packages/compiler/src/cli.ts src/schema.ts --ts --rs --bcode",
    "build": "tsc -b",
    "test": "npm run generate && tsx --test test/*.test.ts",
    "bench": "npm run bench:parse && npm run bench:round-trip",
    "bench:parse": "npm run generate && tsx bench/parse.ts",
    "bench:round-trip": "npm run generate && tsx bench/round-trip.ts",
    "bench:backends": "npm run generate:all && tsx bench/backends.ts",
    "bench:rs": "npm run generate:all && tsx bench/backends.ts --only rust",
    "bench:bcode": "npm run generate:all && tsx bench/backends.ts --only bcode",
    "browser:build": "tsx ../../scripts/browser-build.ts iso-duration",
    "perf:baseline": "tsx ../../scripts/perf-gate.ts iso-duration --write",
    "perf:gate": "tsx ../../scripts/perf-gate.ts iso-duration",
    "size:baseline": "npm run browser:build && tsx ../../scripts/size-gate.ts iso-duration --write",
    "size:gate": "npm run browser:build && tsx ../../scripts/size-gate.ts iso-duration",
    "baseline": "npm run generate && npm run perf:baseline && npm run size:baseline",
    "gate": "npm run generate && npm run perf:gate && npm run size:gate"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@parser2/parser": "0.0.0"
  }
}
